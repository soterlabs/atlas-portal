# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel
.vercel/output/

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# python (renderer)
__pycache__/
*.pyc
*.pyo
*.egg-info/

.trigger

# Notion API local cache
.notion-cache/

# SvelteKit (should not exist in this Next.js repo)
.svelte-kit/

# IDEs and editors
.vscode/
.cursor/
.cursorrules
.idea/

# Debug data
.debug-data/

logs
.claude/worktrees/

# transient dry-run output of scripts/search-expansion/generate.ts
data/search/expansion-batch-requests.json
data/search/query-rewrite-cache.json

# transformers.js model cache for the artifact build scripts (scripts/embedding-eval/transformers-env.ts)
/.cache/

# Sibling temp files of the atomic artifact writes (scripts/build-search-vectors.ts)
public/*.tmp

# ONNX Runtime Web loader + WASM, copied from node_modules by scripts/copy-ort-wasm.mjs (predev/prebuild)
public/ort/

# Search artifacts + Atlas pin: generated on every build by scripts/prebuild.mjs from one
# pinned Atlas commit (never committed — a committed copy goes stale with the Atlas).
/.atlas-snapshot.json
public/atlas-snapshot.json
public/atlas-search-index.json
public/atlas-search-vectors.json
public/atlas-search-vectors.bin
public/atlas-search-families.json
public/atlas-abbreviations.json
data/duplicate-census.json
